<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /paddockid/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Blokir file sensitif & folder internal (jangan pernah dilayani publik)
<FilesMatch "^(\.env.*|\.user\.ini|\.htaccess|\.gitignore|composer\.(json|lock)|.*\.(sql|gz|zip|bak|old|log|md|tgz))$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^/(application/(cache|logs|config|controllers|core|helpers|hooks|language|libraries|models|third_party)|system|vendor|database|docs|scripts|tools|soketi)(/.*)?$

# (Proteksi eksekusi PHP di uploads/ diatur via uploads/.htaccess terpisah)

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresDefault "access plus 1 day"
</IfModule>

FileETag None

# Security headers (satu blok, tidak duplikat)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self' data: blob: https://cdn.paddockid.web.id; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.paddockid.web.id https://js.pusher.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.paddockid.web.id https://fonts.googleapis.com; font-src 'self' data: https://cdn.paddockid.web.id https://fonts.gstatic.com; img-src 'self' data: blob: https://cdn.paddockid.web.id; connect-src 'self' data: blob: https://cdn.paddockid.web.id https://api.jolpi.ca https://*.jolpi.ca https://unpkg.com wss://ws-ap1.pusher.com wss://*.pusher.com https://sockjs-ap1.pusher.com https://*.pusher.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>
