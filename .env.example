# PaddockID environment template. Salin ke .env dan isi nilai asli.
# Jangan pernah commit file .env.

# production | testing | development
CI_ENV=production

# Wajib di production: URL publik lengkap dengan trailing slash.
BASE_URL=https://paddockid.web.id/
# Opsional, dipisah koma. Jika diisi, host pada BASE_URL harus ada di sini.
ALLOWED_HOSTS=paddockid.web.id

DB_HOST=localhost
DB_USER=paddockid
DB_PASS=
DB_NAME=paddockid

# Kosongkan untuk menyimpan upload di FCPATH (lokal).
# Di production, arahkan ke folder origin CDN yang bisa ditulis PHP.
UPLOAD_BASE_PATH=

ENCRYPTION_KEY=

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_CRYPTO=tls

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Moderasi otomatis: biarkan false sampai service + review admin siap.
MODERATION_ENABLED=false
